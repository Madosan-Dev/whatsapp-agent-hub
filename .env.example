# Servidor HTTP Axum
PORT=3000
RUST_LOG=whatsapp_agent_hub=info,tower_http=info

# Banco de Dados SQLite (criado e migrado automaticamente no boot)
DATABASE_URL=sqlite:hub.db?mode=rwc

# Autenticação HTTP Basic do Painel Administrativo (/ e /admin/*)
ADMIN_USER=admin
ADMIN_PASS=troque_esta_senha_forte

# Evolution API (WhatsApp REST)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_evolution_api

# Google Gemini API (gemini-2.5-flash)
GEMINI_API_KEY=sua_chave_google_gemini
